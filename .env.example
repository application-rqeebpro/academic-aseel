# GEMINI_API_KEY: Required for Gemini AI API calls (Explain Lesson, Assignment Generator, AI Chat Assistant).
# On Vercel: Set in Project Settings -> Environment Variables.
GEMINI_API_KEY=""

# ADMIN_PASSWORD: Password for the admin dashboard panel (defaults to A7820600 if unset).
ADMIN_PASSWORD=""

# JWT_SECRET: Secret key for signing secure student and admin authentication tokens.
JWT_SECRET=""

# WHATSAPP_NUMBER: Support & activation contact number (e.g. 785502919).
WHATSAPP_NUMBER=""

# VERCEL: Automatically provided by Vercel runtime ("1").
# VERCEL="1"
